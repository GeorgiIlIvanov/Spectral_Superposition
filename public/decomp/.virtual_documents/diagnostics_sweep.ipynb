def parse_filename(fname):
    name = fname.stem
    parts = name.split('_')
    return {
        'n': int(parts[0][1:]),
        'm': int(parts[1][1:]),
        's': float(parts[2][1:]),
        'seed': int(parts[3][4:])
    }

parsed_files = []
