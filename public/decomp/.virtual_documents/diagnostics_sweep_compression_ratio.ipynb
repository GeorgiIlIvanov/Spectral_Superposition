missing_combos = []
for m in m_unique:
    for s in s_unique:
        key = (int(m), round(s, 6))
        if key not in completion_map or len(completion_map[key]) == 0:
            missing_combos.append((m, s))

if missing_combos:
    print(f"\nMissing combinations (first 20 of {len(missing_combos)}):")
    for m, s in missing_combos[:20]:
        print(f"  m={m}, sparsity={s:.6f}")



